/-- **The self-test**: all `2000` rows verify in one kernel reduction, in `10.0 s`. -/
theorem selfTest : selfTestData.all (fun c => c.check 6) = true := by decide +kernel

/-- **What the self-test buys**: every row of `selfTestData` with positive numerator and
denominator yields a genuine bound on a real fifth-power-exponent number.  This is the shape in
which the `799` Bernstein triangles and the `4582` rectangles will consume their own lists. -/
theorem selfTest_sound {c : FifthClaim} (hc : c ∈ selfTestData) (h1 : 0 < c.num)
    (h2 : 0 < c.den) : (c.base : ℝ) ^ ((c.exp : ℝ) / 5) ≤ ((c.rhs 6 : ℚ) : ℝ) :=
  FifthClaim.check_sound (List.all_eq_true.mp selfTest c hc) (FifthClaim.base_pos h1 h2)

end CenteredMaximal.Fractional

