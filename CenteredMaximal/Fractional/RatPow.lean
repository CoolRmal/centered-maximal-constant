/-!
# Rational enclosures of fifth-power rational exponents

The `α = 6/5` certificate compares rational data against real numbers `x ^ (p / 5)` — concretely
`|x| ^ (9/5)` and `r ^ (-12/5)`.  This file turns each such real number into a pair of explicit
rationals bracketing it, computably and with a kernel-checkable proof.

## Method

For `0 < x` and `0 ≤ p` the whole content is the equivalence

`q ≤ x ^ (p/5)  ↔  q ^ 5 ≤ x ^ p`   (for `0 ≤ q`),

which is `rpow_fifth_pow_five` together with `le_of_pow_le_pow_left₀`; this is the pattern already
used once in `CenteredMaximal.Fractional.KernelMass` for `(7/4) ^ (4/5)`, generalised.  Writing
`x ^ p = a / b` with `a, b` natural and scaling by `10 ^ (5 * prec)`, the best `prec`-digit
rational below `x ^ (p/5)` is `m / 10 ^ prec` with `m` the integer fifth root of
`a * 10 ^ (5 * prec) / b`, and `(m + 1) / 10 ^ prec` lies strictly above.  Negative `p` is handled
by replacing `x` with `x⁻¹`, *not* by inverting the enclosure: the inequalities then never have to
be flipped, and no positivity side condition on the enclosure itself is needed.

## Main results

* `rpow_fifth_pow_five`, `le_rpow_fifth`, `rpow_fifth_le`: the fifth-power bridge.
* `rpowFifthEnc`: the computable enclosure, with `rpowFifthEnc_le` and `le_rpowFifthEnc`.
* `rpowFifthEnc_pos`: both ends of the enclosure of a positive number are positive.
* `rpow_int_fifth_mono`, `rpow_int_fifth_anti`: monotonicity in the base, increasing for `0 ≤ p`
  and decreasing for `p ≤ 0`, so a bound over a box follows from its endpoints.
* `rpow_nine_fifths_mono`, `rpow_neg_twelve_fifths_anti`: the two instances the certificate uses.
-/

@[expose] public section

namespace CenteredMaximal.Fractional

open scoped Real

/-! ### The fifth-power bridge -/

/-- **`(x ^ (p/5)) ^ 5 = x ^ p`** for `0 ≤ x` and a natural exponent `p`: taking a fifth power
undoes dividing the exponent by five. -/
theorem rpow_fifth_pow_five {x : ℝ} (hx : 0 ≤ x) (p : ℕ) :
    ((x ^ ((p : ℝ) / 5)) ^ 5) = x ^ p := by
  rw [← Real.rpow_natCast (x ^ ((p : ℝ) / 5)) 5, ← Real.rpow_mul hx,
    show (p : ℝ) / 5 * ((5 : ℕ) : ℝ) = ((p : ℕ) : ℝ) from by push_cast; ring,
    Real.rpow_natCast]

/-- **Certifying a lower bound**: a nonnegative `q` with `q ^ 5 ≤ x ^ p` lies below
`x ^ (p/5)`. -/
theorem le_rpow_fifth {x q : ℝ} (hx : 0 ≤ x) {p : ℕ} (h : q ^ 5 ≤ x ^ p) :
    q ≤ x ^ ((p : ℝ) / 5) :=
  le_of_pow_le_pow_left₀ (n := 5) (by norm_num) (Real.rpow_nonneg hx _)
    (by rwa [rpow_fifth_pow_five hx])

/-- **Certifying an upper bound**: a nonnegative `q` with `x ^ p ≤ q ^ 5` lies above
`x ^ (p/5)`. -/
theorem rpow_fifth_le {x q : ℝ} (hx : 0 ≤ x) (hq : 0 ≤ q) {p : ℕ} (h : x ^ p ≤ q ^ 5) :
    x ^ ((p : ℝ) / 5) ≤ q :=
  le_of_pow_le_pow_left₀ (n := 5) (by norm_num) hq (by rwa [rpow_fifth_pow_five hx])

/-- **Negative exponents**: `x ^ (-P/5) = (x⁻¹) ^ (P/5)`, which is how `rpowFifthEnc` avoids
inverting an enclosure and flipping its inequalities. -/
theorem rpow_fifth_neg {x : ℝ} (hx : 0 ≤ x) (P : ℕ) :
    x ^ (-(P : ℝ) / 5) = x⁻¹ ^ ((P : ℝ) / 5) := by
  rw [neg_div, Real.rpow_neg hx, Real.inv_rpow hx]

/-! ### The computable enclosure -/

/-- The integer heart of the enclosure: `⌊ (a / b) ^ (1/5) · 10 ^ prec ⌋` for naturals `a, b`,
computed as the integer fifth root of `a · 10 ^ (5 · prec) / b`.  Pure `Nat` arithmetic, so the
kernel evaluates it with GMP throughout. -/
def fifthDigits (a b prec : ℕ) : ℕ := iroot5 (a * 10 ^ (5 * prec) / b)

/-- The enclosure of `y ^ (1/5)` for a positive rational `y`, as the pair
`(m / 10 ^ prec, (m + 1) / 10 ^ prec)`. -/
def fifthEnc (y : ℚ) (prec : ℕ) : ℚ × ℚ :=
  let m : ℕ := fifthDigits y.num.toNat y.den prec
  ((m : ℚ) / 10 ^ prec, ((m : ℚ) + 1) / 10 ^ prec)

/-- **A rational lower/upper enclosure of `x ^ (p / 5)` for `0 < x`**, to a requested precision:
`prec` decimal digits after the point.  A negative exponent is routed through `x⁻¹`. -/
def rpowFifthEnc (x : ℚ) (p : ℤ) (prec : ℕ) : ℚ × ℚ :=
  if 0 ≤ p then fifthEnc (x ^ p.toNat) prec else fifthEnc (x⁻¹ ^ (-p).toNat) prec

/-! ### Soundness of the rational enclosure -/

/-- The scaled integer inequality behind the lower end of `fifthEnc`, in `ℚ`. -/
theorem fifthEnc_fst_pow_five_le {y : ℚ} (hy : 0 < y) (prec : ℕ) :
    (fifthEnc y prec).1 ^ 5 ≤ y := by
  have hden : (0 : ℚ) < (y.den : ℚ) := by exact_mod_cast y.pos
  have hnum : ((y.num.toNat : ℕ) : ℤ) = y.num := Int.toNat_of_nonneg (Rat.num_nonneg.mpr hy.le)
  have h1 : fifthDigits y.num.toNat y.den prec ^ 5 * y.den
      ≤ y.num.toNat * 10 ^ (5 * prec) := (Nat.le_div_iff_mul_le y.pos).mp iroot5_le
  have h2 : ((fifthDigits y.num.toNat y.den prec : ℚ)) ^ 5 * (y.den : ℚ)
      ≤ (y.num : ℚ) * 10 ^ (5 * prec) := by
    have h1' : ((fifthDigits y.num.toNat y.den prec : ℕ) : ℤ) ^ 5 * (y.den : ℤ)
        ≤ ((y.num.toNat : ℕ) : ℤ) * 10 ^ (5 * prec) := by exact_mod_cast h1
    rw [hnum] at h1'
    exact_mod_cast h1'
  have hscale : ((10 : ℚ) ^ prec) ^ 5 = 10 ^ (5 * prec) := by
    rw [← pow_mul, Nat.mul_comm]
  have hy2 : y * 10 ^ (5 * prec) = ((y.num : ℚ) * 10 ^ (5 * prec)) / (y.den : ℚ) := by
    rw [eq_div_iff hden.ne', ← Rat.mul_den_eq_num y]; ring
  simp only [fifthEnc, div_pow, hscale]
  rw [div_le_iff₀ (by positivity), hy2, le_div_iff₀ hden]
  exact h2

/-- The scaled integer inequality behind the upper end of `fifthEnc`, in `ℚ`. -/
theorem lt_fifthEnc_snd_pow_five {y : ℚ} (hy : 0 < y) (prec : ℕ) :
    y < (fifthEnc y prec).2 ^ 5 := by
  have hden : (0 : ℚ) < (y.den : ℚ) := by exact_mod_cast y.pos
  have hnum : ((y.num.toNat : ℕ) : ℤ) = y.num := Int.toNat_of_nonneg (Rat.num_nonneg.mpr hy.le)
  have h1 : y.num.toNat * 10 ^ (5 * prec)
      < (fifthDigits y.num.toNat y.den prec + 1) ^ 5 * y.den :=
    (Nat.div_lt_iff_lt_mul y.pos).mp lt_iroot5_succ
  have h2 : (y.num : ℚ) * 10 ^ (5 * prec)
      < ((fifthDigits y.num.toNat y.den prec : ℚ) + 1) ^ 5 * (y.den : ℚ) := by
    have h1' : ((y.num.toNat : ℕ) : ℤ) * 10 ^ (5 * prec)
        < (((fifthDigits y.num.toNat y.den prec : ℕ) : ℤ) + 1) ^ 5 * (y.den : ℤ) := by
      exact_mod_cast h1
    rw [hnum] at h1'
    exact_mod_cast h1'
  have hscale : ((10 : ℚ) ^ prec) ^ 5 = 10 ^ (5 * prec) := by
    rw [← pow_mul, Nat.mul_comm]
  have hy2 : y * 10 ^ (5 * prec) = ((y.num : ℚ) * 10 ^ (5 * prec)) / (y.den : ℚ) := by
    rw [eq_div_iff hden.ne', ← Rat.mul_den_eq_num y]; ring
  simp only [fifthEnc, div_pow, hscale]
  rw [lt_div_iff₀ (by positivity), hy2, div_lt_iff₀ hden]
  exact h2

/-- Both ends of `fifthEnc` are nonnegative. -/
theorem fifthEnc_fst_nonneg (y : ℚ) (prec : ℕ) : 0 ≤ (fifthEnc y prec).1 := by
  simp only [fifthEnc]
  positivity

/-- The upper end of `fifthEnc` is strictly positive. -/
theorem fifthEnc_snd_pos (y : ℚ) (prec : ℕ) : 0 < (fifthEnc y prec).2 := by
  simp only [fifthEnc]
  positivity

/-- **The lower end of `fifthEnc y prec` is below `y ^ (1/5)`**, transported to `ℝ`. -/
theorem fifthEnc_fst_le_rpow {y : ℚ} (hy : 0 < y) (prec : ℕ) :
    ((fifthEnc y prec).1 : ℝ) ≤ (y : ℝ) ^ ((1 : ℝ) / 5) := by
  have hy' : (0 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy.le
  have h := le_rpow_fifth (q := ((fifthEnc y prec).1 : ℝ)) (p := 1) hy' ?_
  · simpa using h
  · rw [pow_one]
    exact_mod_cast fifthEnc_fst_pow_five_le hy prec

/-- **The upper end of `fifthEnc y prec` is above `y ^ (1/5)`**, transported to `ℝ`. -/
theorem rpow_le_fifthEnc_snd {y : ℚ} (hy : 0 < y) (prec : ℕ) :
    (y : ℝ) ^ ((1 : ℝ) / 5) ≤ ((fifthEnc y prec).2 : ℝ) := by
  have hy' : (0 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy.le
  have hq : (0 : ℝ) ≤ ((fifthEnc y prec).2 : ℝ) := by
    exact_mod_cast (fifthEnc_snd_pos y prec).le
  have h := rpow_fifth_le (q := ((fifthEnc y prec).2 : ℝ)) (p := 1) hy' hq ?_
  · simpa using h
  · rw [pow_one]
    exact_mod_cast (lt_fifthEnc_snd_pow_five hy prec).le


/-! ### The enclosure of `x ^ (p / 5)` -/

/-- Raising to the natural power `P` and then to `1/5` is raising to `P/5`. -/
theorem rpow_one_fifth_pow {x : ℝ} (hx : 0 ≤ x) (P : ℕ) :
    (x ^ P) ^ ((1 : ℝ) / 5) = x ^ ((P : ℝ) / 5) := by
  rw [← Real.rpow_natCast x P, ← Real.rpow_mul hx, mul_one_div]

/-- **Soundness of `rpowFifthEnc`**: the pair really brackets `x ^ (p/5)`.  For `0 ≤ p` this is
`fifthEnc` applied to `x ^ p`; for `p < 0` it is `fifthEnc` applied to `x⁻¹ ^ (-p)`, and
`rpow_fifth_neg` identifies the two. -/
theorem rpowFifthEnc_spec {x : ℚ} (hx : 0 < x) (p : ℤ) (prec : ℕ) :
    ((rpowFifthEnc x p prec).1 : ℝ) ≤ (x : ℝ) ^ ((p : ℝ) / 5) ∧
      (x : ℝ) ^ ((p : ℝ) / 5) ≤ ((rpowFifthEnc x p prec).2 : ℝ) := by
  have hxR : (0 : ℝ) < (x : ℝ) := by exact_mod_cast hx
  simp only [rpowFifthEnc]
  by_cases hp : (0 : ℤ) ≤ p
  · have hy : (0 : ℚ) < x ^ p.toNat := pow_pos hx _
    have hval : (((x ^ p.toNat : ℚ)) : ℝ) ^ ((1 : ℝ) / 5) = (x : ℝ) ^ ((p : ℝ) / 5) := by
      rw [Rat.cast_pow, rpow_one_fifth_pow hxR.le, ← Int.cast_natCast (R := ℝ),
        Int.toNat_of_nonneg hp]
    rw [if_pos hp, ← hval]
    exact ⟨fifthEnc_fst_le_rpow hy prec, rpow_le_fifthEnc_snd hy prec⟩
  · have hxi : (0 : ℚ) < x⁻¹ := inv_pos.mpr hx
    have hy : (0 : ℚ) < x⁻¹ ^ (-p).toNat := pow_pos hxi _
    have hval : (((x⁻¹ ^ (-p).toNat : ℚ)) : ℝ) ^ ((1 : ℝ) / 5) = (x : ℝ) ^ ((p : ℝ) / 5) := by
      rw [Rat.cast_pow, Rat.cast_inv, rpow_one_fifth_pow (inv_nonneg.mpr hxR.le),
        ← rpow_fifth_neg hxR.le]
      congr 1
      rw [neg_div, ← Int.cast_natCast (R := ℝ), Int.toNat_of_nonneg (by omega : (0 : ℤ) ≤ -p)]
      push_cast
      ring
    rw [if_neg hp, ← hval]
    exact ⟨fifthEnc_fst_le_rpow hy prec, rpow_le_fifthEnc_snd hy prec⟩

/-- **The lower enclosure is a lower bound.** -/
theorem rpowFifthEnc_le {x : ℚ} (hx : 0 < x) (p : ℤ) (prec : ℕ) :
    ((rpowFifthEnc x p prec).1 : ℝ) ≤ (x : ℝ) ^ ((p : ℝ) / 5) :=
  (rpowFifthEnc_spec hx p prec).1

/-- **The upper enclosure is an upper bound.** -/
theorem le_rpowFifthEnc {x : ℚ} (hx : 0 < x) (p : ℤ) (prec : ℕ) :
    (x : ℝ) ^ ((p : ℝ) / 5) ≤ ((rpowFifthEnc x p prec).2 : ℝ) :=
  (rpowFifthEnc_spec hx p prec).2

/-- The lower end of the enclosure is never negative. -/
theorem rpowFifthEnc_fst_nonneg (x : ℚ) (p : ℤ) (prec : ℕ) : 0 ≤ (rpowFifthEnc x p prec).1 := by
  simp only [rpowFifthEnc]
  split <;> exact fifthEnc_fst_nonneg _ _

/-- The upper end of the enclosure is strictly positive, so it may be divided by. -/
theorem rpowFifthEnc_pos (x : ℚ) (p : ℤ) (prec : ℕ) : 0 < (rpowFifthEnc x p prec).2 := by
  simp only [rpowFifthEnc]
  split <;> exact fifthEnc_snd_pos _ _

/-! ### Monotonicity in the base

An interval evaluator bounds `x ↦ x ^ (p/5)` over a box from the endpoints of the box, so it
needs to know the direction of the monotonicity, which is the sign of `p`. -/

/-- For `0 ≤ p` the map `x ↦ x ^ (p/5)` is monotone increasing on `[0, ∞)`. -/
theorem rpow_int_fifth_mono {p : ℤ} (hp : 0 ≤ p) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    a ^ ((p : ℝ) / 5) ≤ b ^ ((p : ℝ) / 5) := by
  refine Real.rpow_le_rpow ha hab ?_
  have : (0 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
  linarith

/-- For `p ≤ 0` the map `x ↦ x ^ (p/5)` is monotone decreasing on `(0, ∞)`. -/
theorem rpow_int_fifth_anti {p : ℤ} (hp : p ≤ 0) {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    b ^ ((p : ℝ) / 5) ≤ a ^ ((p : ℝ) / 5) := by
  refine Real.rpow_le_rpow_of_nonpos ha hab ?_
  have : (p : ℝ) ≤ 0 := by exact_mod_cast hp
  linarith

/-- **`x ↦ x ^ (9/5)` is monotone increasing on `[0, ∞)`.** -/
theorem rpow_nine_fifths_mono {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    a ^ (9 / 5 : ℝ) ≤ b ^ (9 / 5 : ℝ) :=
  Real.rpow_le_rpow ha hab (by norm_num)

/-- **`x ↦ x ^ (-12/5)` is monotone decreasing on `(0, ∞)`.** -/
theorem rpow_neg_twelve_fifths_anti {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    b ^ (-12 / 5 : ℝ) ≤ a ^ (-12 / 5 : ℝ) :=
  Real.rpow_le_rpow_of_nonpos ha hab (by norm_num)

/-! ### The two exponents the certificate uses -/

/-- The enclosure of `x ^ (9/5)`, in the literal form the certificate meets it. -/
theorem rpowFifthEnc_nine_fifths {x : ℚ} (hx : 0 < x) (prec : ℕ) :
    ((rpowFifthEnc x 9 prec).1 : ℝ) ≤ (x : ℝ) ^ (9 / 5 : ℝ) ∧
      (x : ℝ) ^ (9 / 5 : ℝ) ≤ ((rpowFifthEnc x 9 prec).2 : ℝ) := by
  have h := rpowFifthEnc_spec hx 9 prec
  rwa [show (((9 : ℤ) : ℝ) / 5) = (9 / 5 : ℝ) from by norm_num] at h

/-- The enclosure of `x ^ (-12/5)`, in the literal form the certificate meets it. -/
theorem rpowFifthEnc_neg_twelve_fifths {x : ℚ} (hx : 0 < x) (prec : ℕ) :
    ((rpowFifthEnc x (-12) prec).1 : ℝ) ≤ (x : ℝ) ^ (-12 / 5 : ℝ) ∧
      (x : ℝ) ^ (-12 / 5 : ℝ) ≤ ((rpowFifthEnc x (-12) prec).2 : ℝ) := by
  have h := rpowFifthEnc_spec hx (-12) prec
  rwa [show ((((-12) : ℤ) : ℝ) / 5) = (-12 / 5 : ℝ) from by norm_num] at h


/-! ### Certificate rows, self-test, and measured kernel throughput

Three facts about kernel throughput were measured here and govern how the certificate files must
be written.

*Rational arithmetic is elaborator-irreducible.*  Plain `decide` cannot reduce even
`(7/4 : ℚ).num`, and `rfl` fails on it, because core marks the `ℚ` operations irreducible.  The
kernel reduces them perfectly well, so every certificate check over `ℚ` must be closed by
`decide +kernel`, which adds no axiom beyond `propext, Classical.choice, Quot.sound`.  Checks that
stay in `ℕ`, such as `fifthDigits` and `iroot5`, close under plain `decide`.

*Numerals in a long list must have a known expected type.*  `2000` rows written as bare tuples of
numerals cost `104 s` to **elaborate** (and `200` such rows already cost `30 s`): each numeral's
`OfNat` problem is postponed and the queue grows quadratically.  The same `2000` rows written as
anonymous constructors of a structure, where every field's type is fixed in advance, elaborate in
`1.8 s`.  Certificate data therefore goes into a structure, never into bare tuples.

*Shard size.*  One `decide +kernel` over `2000` rows costs `10.0 s` wall
(`/usr/bin/time -p lake env lean`, against a `0.85 s` empty-file baseline), about `4.6 ms` per row;
`500` rows cost `3.0 s` of work and `8000` rows cost `39 s` of user time but `62 s` of system time,
i.e. the memory traffic of the reduced list — not the arithmetic — turns superlinear well before
the `20000`-item ceiling that pure integer comparisons tolerate.  Shard `ℚ`-level certificates at
a few thousand rows per `decide`. -/

/-- One row of a fifth-root certificate: the claim that `(num / den) ^ (exp / 5)` is at most
`bound / 10 ^ prec`, with `prec` supplied by the check.  A *structure* rather than a tuple so that
every numeral in a long list of rows has a known type; see the discussion above. -/
structure FifthClaim where
  /-- Numerator of the rational base. -/
  num : ℕ
  /-- Denominator of the rational base. -/
  den : ℕ
  /-- Numerator of the exponent, whose denominator is five. -/
  exp : ℤ
  /-- Numerator of the claimed upper bound, whose denominator is `10 ^ prec`. -/
  bound : ℕ

namespace FifthClaim

/-- The base of a claim as a rational. -/
def base (c : FifthClaim) : ℚ := (c.num : ℚ) / (c.den : ℚ)

/-- The claimed bound of a claim as a rational, at precision `prec`. -/
def rhs (c : FifthClaim) (prec : ℕ) : ℚ := (c.bound : ℚ) / 10 ^ prec

/-- The single kernel check for one row: the computed upper enclosure is at most the claim. -/
def check (c : FifthClaim) (prec : ℕ) : Bool :=
  decide ((rpowFifthEnc c.base c.exp prec).2 ≤ c.rhs prec)

/-- A row with positive numerator and denominator has positive base. -/
theorem base_pos {c : FifthClaim} (h1 : 0 < c.num) (h2 : 0 < c.den) : 0 < c.base := by
  refine div_pos ?_ ?_ <;> exact_mod_cast ‹_›

/-- **Soundness of one row**: a check that passes bounds the *real* number `base ^ (exp/5)`. -/
theorem check_sound {c : FifthClaim} {prec : ℕ} (hc : c.check prec = true) (hb : 0 < c.base) :
    (c.base : ℝ) ^ ((c.exp : ℝ) / 5) ≤ ((c.rhs prec : ℚ) : ℝ) :=
  (le_rpowFifthEnc hb _ _).trans (by exact_mod_cast of_decide_eq_true hc)

end FifthClaim

set_option maxHeartbeats 0 in
set_option maxRecDepth 4000000 in
